# Copia este archivo como ".env" y completa los valores. NUNCA subas ".env" a GitHub.

# Cadena de conexión de Neon (Dashboard -> Connect). Debe terminar en ?sslmode=require
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Texto largo y aleatorio para firmar los tokens de sesión.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Orígenes del frontend autorizados (separados por coma)
CORS_ORIGIN=http://localhost:5173

# ID de cliente de Google (Google Cloud -> APIs y servicios -> Credenciales). No es secreto.
GOOGLE_CLIENT_ID=303596453608-hdr9ke8bouuf3i040ven8sl13ovf8rg3.apps.googleusercontent.com

PORT=3001
